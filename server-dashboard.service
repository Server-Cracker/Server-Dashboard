[Unit]
Description=Server Dashboard
After=network.target docker.service

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/Server-Dashboard
EnvironmentFile=/home/server/Server-Dashboard/.env
ExecStart=/home/server/Server-Dashboard/venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
